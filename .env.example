# Contoh isi .env — salin file ini menjadi `.env` lalu isi nilainya.
# `.env` sengaja tidak di-commit; file contoh ini yang masuk repo.

BASE_URL=https://api.example.com

# Dikirim sebagai header `apikey` — dipakai endpoint /auth.
API_KEY=isi-dengan-api-key-dari-tim-backend

# Kunci layanan pembayaran — BERBEDA dari API_KEY di atas, dan dikirim sebagai
# header `X-API-Key` (bukan `apikey`).
API_KEY_PAYMENT=isi-dengan-api-key-pembayaran-dari-tim-backend

# App ID OneSignal (push notification). Ambil di dashboard OneSignal:
# Settings → Keys & IDs. Bukan rahasia, tapi dipisah agar app dev & produksi
# bisa ditukar tanpa mengubah kode. Kosongkan untuk mematikan push.
ONESIGNAL_APP_ID=isi-dengan-app-id-onesignal

# Penghapusan akun (syarat Google Play). Selama `false`, halaman Hapus Akun
# berjalan sebagai tiruan — alurnya utuh & pembeli tetap dikeluarkan, tapi
# tidak ada permintaan yang dikirim ke server. Ubah ke `true` setelah endpoint
# DELETE /customer/account tersedia.
DELETE_ACCOUNT_LIVE=false

# Ganti Item Tidak Tersedia. Selama `false`, modul ini tiruan: item habis hanya
# dipicu dari menu debug (Profile → Simulasi Item Habis), pilihan pembeli
# disimpan di HP, dan bayar selisih tidak membuat tagihan sungguhan. Ubah ke
# `true` setelah endpoint-nya tersedia di server.
ITEM_SWAP_LIVE=false
